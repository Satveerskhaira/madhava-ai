{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulegraph.dev/schemas/investigator.schema.json",
  "title": "Investigator playbook",
  "type": "object",
  "properties": {
    "default": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array"
        },
        "modes": {
          "type": "object"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "notes": {
                "type": "string"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
