{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulegraph.dev/schemas/policy.schema.json",
  "title": "Policy section (source text a rule is derived from)",
  "type": "object",
  "required": [
    "doc",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "doc": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string"
    },
    "version": {
      "type": [
        "string",
        "number"
      ]
    },
    "effective_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owner": {
      "type": "string"
    },
    "sample": {
      "type": "boolean"
    }
  }
}
