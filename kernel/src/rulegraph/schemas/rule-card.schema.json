{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulegraph.dev/schemas/rule-card.schema.json",
  "title": "Rule card (one immutable rule version)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "domain",
    "concept",
    "intent",
    "outcome",
    "condition"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "deprecated"
      ]
    },
    "domain": {
      "type": "string"
    },
    "concept": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "outcome": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "reject",
            "pricing",
            "info",
            "override"
          ]
        },
        "code": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        }
      }
    },
    "record_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "condition": {
      "type": "string",
      "minLength": 1,
      "description": "CEL expression"
    },
    "order": {
      "type": "integer"
    },
    "overridden_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "template": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc"
        ],
        "additionalProperties": false,
        "properties": {
          "doc": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "row": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "sme_owner": {
      "type": "string"
    }
  }
}
