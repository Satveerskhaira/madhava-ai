[build-system]
requires = ["setuptools>=69"]
build-backend = "setuptools.build_meta"

[project]
name = "__DIST__"
version = "0.1.0"
description = "__TITLE__ domain agents built on the rulegraph kernel"
requires-python = ">=3.11"
dependencies = ["rulegraph>=0.1"]

[project.optional-dependencies]
dev = ["pytest>=8"]

[project.scripts]
__DIST__ = "__PACKAGE__.cli:main"

[tool.setuptools.packages.find]
where = ["src"]

[tool.setuptools.package-data]
__PACKAGE__ = ["pack/**/*.yaml", "fixtures/**/*.yaml"]

[tool.pytest.ini_options]
testpaths = ["tests"]
filterwarnings = ["ignore::UserWarning", "ignore::DeprecationWarning"]
